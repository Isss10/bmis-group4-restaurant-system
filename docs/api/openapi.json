{
  "components": {
    "schemas": {
      "CurrentIdentity": {
        "description": "What `/api/v1/auth/me` returns about the caller.\n\nDeliberately narrow. It is the minimum the SPA needs to render the right\nnavigation and to decide whether to refresh the token — and it is derived\nfrom a *verified* token rather than from anything the client sends.\n\nNo email, no points balance, no membership tier: those belong to the\nmembership module's own endpoints, and returning them here would let every\nfrontend depend on a shape the membership owner has to keep stable.",
        "properties": {
          "expires_at": {
            "title": "Expires At",
            "type": "integer"
          },
          "role": {
            "$ref": "#/components/schemas/Role"
          },
          "token_id": {
            "title": "Token Id",
            "type": "string"
          },
          "user_id": {
            "title": "User Id",
            "type": "string"
          }
        },
        "required": [
          "user_id",
          "role",
          "token_id",
          "expires_at"
        ],
        "title": "CurrentIdentity",
        "type": "object"
      },
      "Envelope_CurrentIdentity_": {
        "additionalProperties": true,
        "type": "object"
      },
      "Envelope_HealthResponse_": {
        "additionalProperties": true,
        "type": "object"
      },
      "Envelope_ReviewResponse_": {
        "additionalProperties": true,
        "type": "object"
      },
      "FieldError": {
        "description": "One field-level validation or conflict detail.\n\nField names follow the contract's spelling: ``field`` and ``detail``\n(note: ``detail``, not ``message`` — a subtle difference that is easy to get\nwrong and would break the frontend's error display).",
        "properties": {
          "detail": {
            "title": "Detail",
            "type": "string"
          },
          "field": {
            "title": "Field",
            "type": "string"
          }
        },
        "required": [
          "field",
          "detail"
        ],
        "title": "FieldError",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "HealthResponse": {
        "description": "Liveness/readiness payload.",
        "properties": {
