    "/health": {
      "get": {
        "description": "Return process liveness without touching the database.\n\nKept dependency-free on purpose: when MySQL is down we still want the\ncontainer to report that the *process* is alive, so the orchestrator\nrestarts the database rather than killing the API in a loop.\n\nSettings are read from `app.state`, not from `get_settings()`, so an app\nbuilt with custom settings (tests) reports its own environment rather\nthan the process-wide one.",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
