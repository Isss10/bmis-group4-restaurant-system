      "Role": {
        "description": "System roles, ordered from least to most privileged.\n\n`StrEnum` means the value used in JWT claims and database columns is the\nplain lowercase string (\"manager\"), while code compares against the enum\nand cannot typo a role name.",
        "enum": [
          "customer",
          "waiter",
          "manager",
          "admin"
        ],
        "title": "Role",
        "type": "string"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
