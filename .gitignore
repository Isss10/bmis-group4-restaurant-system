# ---------- Secrets & environment ----------
# Never commit real credentials. Use *.example files with placeholders instead.
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
*.jks
secrets/
config/local.*
application-local.yml
application-local.properties
settings-local.py

# ---------- Databases & data dumps ----------
*.sql.gz
*.dump
*.sqlite
*.sqlite3
*.db
*.mdb
data/dumps/
backups/

# ---------- Build output ----------
target/
build/
out/
dist/
bin/
*.class
*.jar
*.war
*.ear
*.egg-info/
.eggs/
*.pyc
__pycache__/
.pytest_cache/
.mypy_cache/
.ruff_cache/
# Python virtual environments. Committing one would add thousands of vendored
# dependency files to a public repository — requirements.txt is the source of
# truth, and every member creates their own environment from it.
.venv/
venv/
env/
ENV/
.python-version
node_modules/
.next/
.nuxt/
.turbo/
.cache/
coverage/
htmlcov/
.coverage
.coverage.*
*.lcov

# ---------- Logs ----------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ---------- Local test & scan output ----------
# Produced when a member runs the same commands CI runs (pytest --junitxml,
# bandit -o). They are per-machine artefacts, not source.
reports/
bandit-report.txt
.jupyter/
.tox/
.nox/

# ---------- IDE / editor ----------
.idea/
*.iml
*.ipr
*.iws
.vscode/
!.vscode/settings.json.example
*.swp
*.swo
*~
.project
.classpath
.settings/

# ---------- OS ----------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini
$RECYCLE.BIN/

# ---------- Docker local volumes ----------
docker-volumes/
mysql-data/
postgres-data/

