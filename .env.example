# ---------------------------------------------------------------------------
# Environment configuration template
# ---------------------------------------------------------------------------
# Copy this file to `.env` and fill in real values:
#
#     cp .env.example .env          (macOS / Linux)
#     Copy-Item .env.example .env   (Windows PowerShell)
#
# `.env` is git-ignored. NEVER commit real credentials — CI fails any pull
# request that adds a `.env` file (see .github/workflows/ci.yml).
#
# Every variable is read with the APP_ prefix by src/common/config.py.
# ---------------------------------------------------------------------------

# --- Application -----------------------------------------------------------
APP_ENVIRONMENT=development
APP_LOG_LEVEL=INFO

# --- Database (MySQL 8.0) --------------------------------------------------
APP_DB_HOST=localhost
APP_DB_PORT=3306
APP_DB_USER=restaurant
APP_DB_PASSWORD=change-me-locally
APP_DB_NAME=restaurant

# Pool tuning. Keep APP_DB_POOL_RECYCLE below MySQL's wait_timeout (8h).
APP_DB_POOL_SIZE=10
APP_DB_MAX_OVERFLOW=20
APP_DB_POOL_RECICLE=3600
APP_DB_ECHO_SQL=false

# --- Security --------------------------------------------------------------
# REQUIRED. Generate a strong one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# The app refuses to sign tokens when this is empty, and refuses to boot in
# production when it is weak or shorter than 32 characters.
APP_JWT_SECRET_KEY=
APP_JWT_ALGORITHM=HS256
APP_ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- CORS ------------------------------------------------------------------
# Comma-separated allow-list of frontend origins. Do NOT use '*' in production
# — the app raises on startup if you do.
APP_CORS_ORIGINS=http://localhost:5173

# --- Rate limiting (slowapi) ------------------------------------------------
APP_RATE_LIMIT_ENABLED=true
APP_RATE_LIMIT_DEFAULT=200/minute
APP_RATE_LIMIT_REVIEW=5/minute

# --- Reservation domain rules ----------------------------------------------
# How long a temporary seat hold survives before automatic expiry.
APP_SEAT_HOLD_TTL_SECONDS=600

# --- Audit logging ----------------------------------------------------------
APP_AUDIT_LOG_ENABLED=true


# ===========================================================================
# PRODUCTION NOTES
# ===========================================================================
# The app refuses to start when APP_ENVIRONMENT=production and any of these
# hold:
#   * APP_JWT_SECRET_KEY is empty, a placeholder, or under 32 characters
#   * APP_DB_PASSWORD is empty or a placeholder
#   * APP_CORS_ORIGINS contains '*'
#
# In production also note:
#   * /docs, /redoc and /openapi.json are disabled automatically. Export the
#     schema at build time instead: python scripts/export_openapi.py
#   * HSTS and a strict Content-Security-Policy are added to every response.
#   * Set these through your deployment platform's secret store, not a file.
# ===========================================================================
